# Панель управления — /opt/telemt-web/.env (chmod 600).
# Значения подставляет инсталлятор (install.sh).

PANEL_USER=admin
PANEL_PASSWORD=<ПАРОЛЬ>
PANEL_PORT=4443
PANEL_HOME=/opt/telemt-web
DATA_DIR=/var/lib/telemt-web

# telemt
TELEMT_API=http://127.0.0.1:9091
TELEMT_CONTAINER=telemt
TELEMT_CONFIG=/opt/telemt/config/config.toml
TELEMT_ENV=/opt/telemt/.env

# xray
XRAY_BIN=/usr/local/bin/xray
XRAY_CONFIG=/usr/local/etc/xray/main.json
XRAY_SERVICE=xray@main.service
XRAY_API=127.0.0.1:10085
XRAY_TAG=vless-8443
XRAY_PORT=8443
XRAY_PUBLIC_HOST=<ПУБЛИЧНЫЙ_АДРЕС>
XRAY_STATE=/var/lib/telemt-web/xray-disabled-users.json
XRAY_HISTORY=/var/lib/telemt-web/xray_history.jsonl
